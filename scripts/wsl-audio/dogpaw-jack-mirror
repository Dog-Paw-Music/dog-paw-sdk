#!/usr/bin/env python3
"""Mirror JACK system:playback_* connections onto dogpaw_pulse inputs.

Architecture:
    Replaces flaky ``jack-plumbing`` daemon mode for the WSL pacat bridge.
    Polls the JACK graph and ensures any client feeding ``system:playback_N``
    is also connected to ``dogpaw_pulse:in_N`` so Windows speakers hear it.
"""

from __future__ import annotations

import os
import signal
import subprocess
import sys
import time


BRIDGE = {
    "system:playback_1": "dogpaw_pulse:in_1",
    "system:playback_2": "dogpaw_pulse:in_2",
}


def jack_lsp_connections() -> list[str]:
    """Return ``jack_lsp -c`` output lines.

    Purpose:
        Snapshot the current JACK port connection graph.
    Return value:
        Lines from ``jack_lsp -c``, or an empty list if JACK is unavailable.
    Requirements/Preconditions:
        ``jack_lsp`` on PATH; JACK server should be running.
    Guarantees/Postconditions:
        Never raises on jack_lsp failure; returns [].
    Invariants:
        Does not modify the JACK graph.
    """

    env = os.environ.copy()
    env.setdefault("JACK_NO_START_SERVER", "1")
    try:
        completed = subprocess.run(
            ["jack_lsp", "-c"],
            check=False,
            capture_output=True,
            text=True,
            env=env,
        )
    except OSError:
        return []
    if completed.returncode != 0:
        return []
    return completed.stdout.splitlines()


def sources_to(port: str, lines: list[str]) -> set[str]:
    """Find JACK ports connected as sources into ``port``.

    Purpose:
        Parse ``jack_lsp -c`` indentation to list who feeds a destination.
    Parameters:
        port: Destination port name, e.g. ``system:playback_1``.
        lines: Output lines from ``jack_lsp -c``.
    Return value:
        Set of source port names currently connected to ``port``.
    Requirements/Preconditions:
        ``lines`` is a full ``jack_lsp -c`` snapshot.
    Guarantees/Postconditions:
        Parsing only; no JACK side effects.
    Invariants:
        Unknown formats yield an empty set rather than raising.
    """

    sources: set[str] = set()
    capturing = False
    for line in lines:
        if not line.startswith(" ") and not line.startswith("\t"):
            capturing = line.strip() == port
            continue
        if capturing:
            sources.add(line.strip())
    return sources


def ensure_connected(source: str, dest: str) -> None:
    """Connect ``source`` to ``dest`` if not already linked.

    Purpose:
        Idempotent ``jack_connect`` wrapper for mirror updates.
    Parameters:
        source: JACK output port name.
        dest: JACK input port name.
    Return value:
        None.
    Requirements/Preconditions:
        Both ports should exist; failures are ignored (port may be transient).
    Guarantees/Postconditions:
        Best-effort connection; does not raise.
    Invariants:
        Never disconnects existing links.
    """

    env = os.environ.copy()
    env.setdefault("JACK_NO_START_SERVER", "1")
    subprocess.run(
        ["jack_connect", source, dest],
        check=False,
        capture_output=True,
        env=env,
    )


def main() -> int:
    """Poll JACK and mirror system playback feeds onto the pacat bridge.

    Purpose:
        Long-lived helper for user systemd on WSL.
    Return value:
        0 on SIGINT/SIGTERM shutdown.
    Requirements/Preconditions:
        JACK server and ``dogpaw_pulse`` ports should appear soon after start.
    Guarantees/Postconditions:
        While running, new connections to ``system:playback_*`` are mirrored.
    Invariants:
        Does not start JACK or pacat.
    """

    os.environ.setdefault("JACK_NO_START_SERVER", "1")
    running = True

    def stop(_signum: int, _frame: object) -> None:
        nonlocal running
        running = False

    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)

    print("dogpaw-jack-mirror: mirroring system:playback_* -> dogpaw_pulse:in_*", flush=True)
    while running:
        lines = jack_lsp_connections()
        for system_port, bridge_port in BRIDGE.items():
            for source in sources_to(system_port, lines):
                if source.startswith("dogpaw_pulse:"):
                    continue
                already = sources_to(bridge_port, lines)
                if source not in already:
                    ensure_connected(source, bridge_port)
                    print(f"dogpaw-jack-mirror: {source} -> {bridge_port}", flush=True)
        time.sleep(0.5)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
