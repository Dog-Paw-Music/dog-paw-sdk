[Unit]
Description=Dog Paw JACK server (dummy backend for WSL/WSLg)
Documentation=file://%h/dog-paw-sdk/scripts/wsl-audio/README.md
After=default.target

[Service]
Type=simple
Environment=JACK_NO_AUDIO_RESERVATION=1
# Match zita-j2a rate below. Dummy has no hardware clock.
ExecStart=/usr/bin/jackd -d dummy -r 48000
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
