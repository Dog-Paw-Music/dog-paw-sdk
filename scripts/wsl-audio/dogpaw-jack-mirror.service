[Unit]
Description=Dog Paw JACK mirror (system:playback → pacat bridge)
Documentation=file:%h/dog-paw-sdk/scripts/wsl-audio/README.md
After=dogpaw-jackd-dummy.service dogpaw-jack-to-pulse.service
Requires=dogpaw-jackd-dummy.service
Wants=dogpaw-jack-to-pulse.service
BindsTo=dogpaw-jackd-dummy.service
PartOf=dogpaw-jackd-dummy.service

[Service]
Type=simple
Environment=JACK_NO_AUDIO_RESERVATION=1
Environment=JACK_NO_START_SERVER=1
ExecStartPre=/usr/bin/jack_wait -w -t 20
ExecStart=/usr/bin/python3 %h/.config/dogpaw/wsl-audio/dogpaw-jack-mirror
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
